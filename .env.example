ANTHROPIC_API_KEY=
# Upstash, copied from the getaiengineer Vercel project (Storage tab). Needed for lead calls,
# call logs and the daily spend total.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Summary email (Resend, sending from the getaiengineer.dev domain)
RESEND_API_KEY=
# Team address for the call summary; empty skips the team email.
AIYAZ_SUMMARY_TO=
# Sender for both emails. Leave commented out for the default below (an empty value means no sender).
# AIYAZ_SUMMARY_FROM=Aiyaz <work@getaiengineer.dev>
# Days a call log and its transcript are kept in Upstash. Default: 30
AIYAZ_TRANSCRIPT_DAYS=30
# Limits and spend
# Per-call cap in USD, Claude plus the voice estimate. Must equal the site's AIYAZ_PER_CALL_USD
# (what the token function reserves per call). Default: 1
AIYAZ_COST_CAP_USD=1
# Deepgram plus TTS cost per call minute, measured in the voice spike. Default: 0.05
AIYAZ_VOICE_USD_PER_MIN=0.05
# Voice (LiveKit Cloud, Deepgram, and ElevenLabs or Cartesia)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
# elevenlabs or cartesia; empty means elevenlabs, any other value stops the worker at start.
AIYAZ_TTS=elevenlabs
AIYAZ_TTS_VOICE_ID=
