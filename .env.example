ANTHROPIC_API_KEY=
# Upstash, copied from the getaiengineer Vercel project (Storage tab). Needed for lead calls,
# call logs and the daily spend total.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Summary email (Resend, sending from the getaiengineer.dev domain)
RESEND_API_KEY=
# Team address for the call summary; empty skips the team email.
AIYAZ_SUMMARY_TO=
# Sender for both emails. Leave commented out for the default below (an empty value means no sender).
# AIYAZ_SUMMARY_FROM=Aiyaz <work@getaiengineer.dev>
# The settings below are commented out so the defaults in src/config.ts apply. An empty number
# would read as 0, so uncomment a line only with a value.
# Days a call log and its transcript are kept in Upstash.
# AIYAZ_TRANSCRIPT_DAYS=30
# Per-call cap in USD, Claude plus the voice estimate. Must equal the site's AIYAZ_PER_CALL_USD
# (what the token function reserves per call).
# AIYAZ_COST_CAP_USD=1
# Deepgram plus TTS cost per call minute, measured in the voice spike (default in src/config.ts).
# AIYAZ_VOICE_USD_PER_MIN=0.05
# Voice (LiveKit Cloud, Deepgram, and ElevenLabs or Cartesia)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
# elevenlabs or cartesia; empty means elevenlabs, any other value stops the worker at start.
AIYAZ_TTS=elevenlabs
# ElevenLabs voice id from the voice library (pnpm voice:audition renders candidates to auditions/).
# Empty means the plugin's default voice.
AIYAZ_TTS_VOICE_ID=
# ElevenLabs model id. eleven_flash_v2_5 is fastest for live calls; eleven_multilingual_v2 sounds
# more natural but is slower. Empty means the plugin default.
AIYAZ_TTS_MODEL=
# LiveKit library log level (trace, debug, info, warn, error, fatal). Default: debug for `dev`,
# info for `start`. The worker drops the library's lk.pii.* fields (what was said) from every
# level, so its logs carry ids and numbers only; our [call] and [latency] lines always print.
# LOG_LEVEL=info
